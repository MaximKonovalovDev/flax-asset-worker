{
  "Name": "FlaxAssetWorker",
  "Version": "1.0.0",
  "Description": "Modular asset pipeline with HTTP/JSON-RPC. Providers, lanes, categories, library. Sibling of flax-mcp; runs out-of-process on port 8790.",
  "Author": "diklaaltman91-ux",
  "AuthorUrl": "https://github.com/diklaaltman91-ux",
  "Homepage": "https://github.com/flax-game-studio/flax-asset-worker",
  "RepositoryUrl": "https://github.com/flax-game-studio/flax-asset-worker",
  "License": "MIT",
  "Category": "Pipeline",
  "IsAlpha": false,
  "EditorPlugin": false,
  "GamePlugin": true,
  "SupportedPlatforms": [
    "Windows",
    "Linux",
    "Mac"
  ],
  "MinEngineVersion": "1.9.0",
  "References": [
    "System.Net.Http",
    "Newtonsoft.Json"
  ]
}
